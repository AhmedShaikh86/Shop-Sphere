APP_NAME=ShopSphere
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=localhost:3000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Optional: Cloudinary, used only if you wire up a Cloudinary filesystem disk.
CLOUDINARY_URL=

# Optional: leave blank to use the built-in demo payment gateway (see
# App\Services\Payments\DemoPaymentGateway). Setting STRIPE_SECRET switches
# checkout to real Stripe PaymentIntents automatically.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Optional: set this to resolve the homepage hero, category banners, collection
# banners and brand-story image to real Unsplash photography, by running:
#   php artisan images:sync-placements
# This is a one-off sync (not called on every page load, to stay well within
# Unsplash's free-tier rate limit) — see App\Console\Commands\SyncPlacementImages.
# Without it, those slots keep whatever image is already seeded (Picsum
# placeholders), and the frontend falls back to a branded gradient if even
# that fails to load. Get a free key at https://unsplash.com/developers.
UNSPLASH_ACCESS_KEY=

VITE_APP_NAME="${APP_NAME}"
